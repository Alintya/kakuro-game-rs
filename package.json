{
  "name": "kakuro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "bun -e \"require('fs').rmSync('.svelte-kit/.svelte-check', { recursive: true, force: true })\" && bun --bun svelte-kit sync && bun --bun svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "tauri": "bun --bun node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
